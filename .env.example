# =============================================================================
# Python App Starter — configuration (copier en .env, ne jamais versionner .env)
# =============================================================================

# --- Application ---------------------------------------------------------------
APP_NAME="Python App Starter"
# Sigle affiché à côté du logo (barre latérale)
APP_SHORT=PAS
ORG_NAME="Organisation"
TIMEZONE=Europe/Paris
TZ=Europe/Paris
DEBUG=false
# 32 caractères minimum. Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Serveur web -----------------------------------------------------------------
# Sans Docker (Windows : windows\start.bat) : adresse et port d'écoute.
# 0.0.0.0 = accessible depuis le réseau ; 127.0.0.1 = depuis le serveur seulement.
SERVER_HOST=0.0.0.0
SERVER_PORT=8095
# HTTPS sans reverse-proxy : chemins des fichiers PEM du certificat et de sa clé (vides = HTTP).
# Ex. Windows : SSL_CERTFILE=C:/apps/pyapp/certs/cert.pem
SSL_CERTFILE=
SSL_KEYFILE=
# Avec Docker : adresse et port publiés sur la machine hôte.
WEB_PUBLISH_ADDRESS=0.0.0.0
WEB_PUBLISH_PORT=8095
# Nombre de processus web (1 suffit pour un outil interne, et convient à SQLite)
WEB_WORKERS=1
# Adresse(s) du reverse-proxy autorisé(s) à transmettre X-Forwarded-For / -Proto (* = tous : à éviter)
FORWARDED_ALLOW_IPS=127.0.0.1
# auto : cookie Secure dès que la requête arrive en HTTPS (via le proxy). true / false pour forcer.
COOKIE_SECURE=auto
SESSION_IDLE_MINUTES=120

# --- Base de données (MariaDB du compose) ----------------------------------------
# Hors Docker, définir directement DATABASE_URL, par ex. :
#   DATABASE_URL=sqlite:///./data/app.db
#   DATABASE_URL=mysql+pymysql://user:motdepasse@hote:3306/base?charset=utf8mb4
# Mots de passe : lettres et chiffres uniquement (ils entrent dans une URL).
DB_DATABASE=pyapp
DB_USERNAME=pyapp
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PUBLISH_ADDRESS=127.0.0.1
DB_PUBLISH_PORT=3395
MARIADB_VERSION=11.8

# --- Premier administrateur : FACULTATIF -----------------------------------------
# Par défaut, laisser vide : à la première ouverture, l'application affiche une page
# « Première configuration » pour créer l'administrateur depuis le navigateur.
# Pour une installation automatisée, renseigner les trois valeurs (puis vider le mot de passe).
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Sécurité de la connexion ----------------------------------------------------
LOGIN_MAX_FAILED_ACCOUNT=8
LOGIN_MAX_FAILED_PER_IP_USER=12
LOGIN_MAX_FAILED_PER_IP=40
LOGIN_MAX_FAILED_TOTP=6
LOGIN_LOCKOUT_MINUTES=15
RESET_TTL_MINUTES=10
RESET_MAX_PER_IP_HOUR=15
AUDIT_RETENTION_DAYS=365

# --- E-mails (codes de réinitialisation) -----------------------------------------
# SMTP_HOST vide : les e-mails sont écrits dans les journaux du conteneur (développement).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.local
